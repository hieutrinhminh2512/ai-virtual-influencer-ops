# ==========================================
# 1. GEMINI API (Cho AI Kịch bản & Prompt Generator)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 2. TELEGRAM BOT (Duyệt video từ xa qua điện thoại)
# Tạo bot tại @BotFather để lấy Token: https://t.me/BotFather
# Lấy Chat ID của bạn tại @userinfobot: https://t.me/userinfobot
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==========================================
# 3. YOUTUBE DATA API V3 (Tự động đăng video)
# Tạo dự án trên Google Cloud Console: https://console.cloud.google.com/
# Bật YouTube Data API v3, tạo OAuth 2.0 Client ID (Desktop app)
# Tải file về và lưu tên là client_secret.json trong thư mục gốc.
# ==========================================
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_PRIVACY_STATUS=private  # private, unlisted, public

# ==========================================
# 4. CẤU HÌNH WEB UI VÀ PLAYWRIGHT
# ==========================================
PORT=8000
HOST=127.0.0.1
BROWSER_USER_DATA_DIR=./browser_profile
HEADLESS_BROWSER=false
GOOGLE_FLOW_URL=https://labs.google/fx/tools/flow
